    + toString(): std::string

    + setName(name: const std::string&): std::string
    + setAuthor(author: const std::string&): std::string
    + setInterpreter(interpreter: const std::string&): std::string
    + setTop(top: const int&): int

    {static} + operator<<(os: std::ostream&, song: const Song&): std::ostream&
    {static} + operator>>(is: std::istream&, song: Song&): std::istream&
}
